# ==============================================================================
# OmniBrain — Unified Environment Configuration
# Copy this file to '.env' at the repository root or inside 'Backend Development/'
# ==============================================================================

# --- Application Runtime ---
ENVIRONMENT=development
DEBUG=True
BACKEND_URL=http://127.0.0.1:8000

# --- Authentication & Security ---
# Secret key used for signing JWT tokens (generate a 32+ character random string for production)
JWT_SECRET_KEY=omnibrain-dev-insecure-secret-key-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Relational Database ---
# Default zero-friction local SQLite async database:
DATABASE_URL=sqlite+aiosqlite:///./omnibrain.db
# PostgreSQL async connection (uncomment for production or local docker postgres):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omnibrain_db

# --- Qdrant Vector Store ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=False
QDRANT_TEXT_COLLECTION=omnibrain_text
QDRANT_IMAGE_COLLECTION=omnibrain_images
TEXT_VECTOR_SIZE=768
IMAGE_VECTOR_SIZE=512

# --- LLM & Embedding Models (Local Ollama / Remote) ---
CHAT_MODEL=llama3
EMBEDDING_MODEL=nomic-embed-text

# --- Cloudinary (Image & Visual Document Storage) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Guardrails & Observability (Optional) ---
OPENAI_API_KEY=
NEMO_GUARDRAILS_MODEL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
